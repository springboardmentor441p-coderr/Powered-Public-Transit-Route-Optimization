# -----------------------------------------------------------------------------
# AI_RouteRanker Environment Configuration Template
# Copy this file to .env and configure values for your local environment.
# DO NOT commit real secrets, credentials, or actual passwords to version control.
# -----------------------------------------------------------------------------

# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="AI_RouteRanker"
API_V1_STR=/api

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Configuration (JSON array recommended; comma-separated also supported)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_routeranker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/ai_routeranker_db

# Data & Model Artifact Storage Paths (Relative or Absolute)
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
ARTIFACTS_DIR=./artifacts
REPORTS_DIR=./reports
