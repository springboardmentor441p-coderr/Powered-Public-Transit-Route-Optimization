# RouteRanker Environment Variables Template
# CTA API Keys (Official CTA Developer Center: https://www.transitchicago.com/developers/)

# CTA Bus Tracker API Key (Free registration at transitchicago.com/developers/bustracker/)
CTA_BUS_API_KEY=YOUR_CTA_BUS_TRACKER_API_KEY_HERE

# CTA Train Tracker API Key (Free registration at transitchicago.com/developers/traintracker/)
CTA_TRAIN_API_KEY=YOUR_CTA_TRAIN_TRACKER_API_KEY_HERE

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache TTL in seconds for live transit feeds
TRANSIT_CACHE_TTL_SECONDS=30

