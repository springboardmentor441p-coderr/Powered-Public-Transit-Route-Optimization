# AI MetroFlow Environment Variables
# Copy this file to .env and update values

# Application
APP_NAME=AI MetroFlow
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=metroflow
POSTGRES_PASSWORD=metroflow
POSTGRES_DB=metroflow

# MongoDB for Analytics
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=metroflow_analytics

# Redis for Caching and Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# ML Models
MODEL_PATH=/app/models
RETRAIN_INTERVAL_HOURS=24

# WebSocket
SOCKET_IO_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# External APIs (optional)
OPEN_TRANSIT_API_KEY=

# Frontend (for production)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8000