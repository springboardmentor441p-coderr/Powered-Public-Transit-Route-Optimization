# Copy this file to backend\.env (gitignored) and put in the routeranker role's OWN password.
# Never use the postgres superuser password here.
# If the password has characters such as @ : / # %, percent-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://routeranker:CHANGE_ME@localhost:5432/routeranker
TEST_DATABASE_URL=postgresql://routeranker:CHANGE_ME@localhost:5432/routeranker_test
