{\"cells\": [{\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"# Route‑Service Matching Validation\n\nThis notebook reproduces the validation performed in the script `scratch/route_date_matching.py`. It loads the GTFS files, checks consistency of `route_id` and `service_id` references, classifies services by weekday/Sunday availability, and summarises the results.\"]}, {\"cell_type\": \"code\", \"metadata\": {}, \"execution_count\": null, \"outputs\": [], \"source\": [\"import pandas as pd, pathlib\n\nREPO_ROOT = pathlib.Path(r\"C:/Users/kavyasri/Downloads/mtc-gtfs\")\nroutes_df = pd.read_csv(REPO_ROOT / 'routes.txt', dtype=str)\ntrips_df = pd.read_csv(REPO_ROOT / 'trips.txt', dtype=str)\ncalendar_df = pd.read_csv(REPO_ROOT / 'calendar.txt', dtype=str)\n\n# Validate route ids\nroute_ids = set(routes_df['route_id'])\nmissing_route_ids = set(trips_df['route_id']) - route_ids\n\n# Validate service ids\nservice_ids = set(calendar_df['service_id'])\nmissing_service_ids = set(trips_df['service_id']) - service_ids\n\n# Classify services\nweekday_cols = ['monday','tuesday','wednesday','thursday','friday','saturday']\ndef classify(row):\n    wk = all(row[col] == '1' for col in weekday_cols)\n    su = row['sunday'] == '1'\n    if wk and su: return 'Mon‑Sat & Sun'\n    if wk: return 'Mon‑Sat only'\n    if su: return 'Sunday only'\n    return 'No service'\ncalendar_df['service_category'] = calendar_df.apply(classify, axis=1)\nservice_map = calendar_df.set_index('service_id')['service_category'].to_dict()\ntrips_df['service_category'] = trips_df['service_id'].map(service_map)\nsummary = trips_df['service_category'].value_counts(dropna=False)\n\nprint('# Route‑Service Matching Validation Report')\nprint(f"Total routes: {len(routes_df):,}")\nprint(f"Total trips: {len(trips_df):,}")\nprint(f"Total services: {len(calendar_df):,}")\nprint(f"Missing route IDs in trips: {len(missing_route_ids):,}")\nprint(f"Missing service IDs in trips: {len(missing_service_ids):,}")\nprint('Service category breakdown (by trips):')\nfor cat, cnt in summary.items():\n    print(f"- {cat}: {cnt:,}")\n"]}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"The validation shows that all trips reference existing routes and services, indicating data consistency between `trips.txt`, `routes.txt`, and `calendar.txt`.\"]} ], \"metadata\": {\"kernelspec\": {\"display_name\": \"Python 3\", \"language\": \"python\", \"name\": \"python3\"}, \"language_info\": {\"name\": \"python\", \"version\": \"3.12\"}}, \"nbformat\": 4, \"nbformat_minor\": 5}